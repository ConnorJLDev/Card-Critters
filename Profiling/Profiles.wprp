<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Jonathan Sandquist" Company="DigiPen">
  <Profiles>
    <SystemCollector Id="SystemCollector_Nightjar" Base="">
      <BufferSize Value="512" />
      <Buffers Value="256" />
    </SystemCollector>

    <SystemProvider Id="SystemProvider_Nightjar" Base="">
      <Keywords>
        <Keyword Value="PmcProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="Loader" />
        <Keyword Value="ProcessThread" />
      </Keywords>
    </SystemProvider>

    <HardwareCounter Id="HardwareCounter_Nightjar_Misses" Base="" Strict="true">
      <SampledCounters>
        <SampledCounter Value="CacheMisses" Interval="4096"/>
        <SampledCounter Value="LLCMisses" Interval="4096"/>
        <SampledCounter Value="LLCReference" Interval="4096"/>
        <!-- <SampledCounter Value="BranchInstructions" Interval="4096"/> -->
        <SampledCounter Value="BranchMispredictions" Interval="4096"/>
      </SampledCounters>
    </HardwareCounter>
    
    <HardwareCounter Id="HardwareCounter_Nightjar_Instructions" Base="" Strict="true">
      <SampledCounters>
        <SampledCounter Value="InstructionRetired" Interval="16384"/>
        <SampledCounter Value="TotalIssues" Interval="16384"/>
        <SampledCounter Value="TotalCycles" Interval="16384"/>
      </SampledCounters>
    </HardwareCounter>
    
    <HardwareCounter Id="HardwareCounter_Nightjar_Usage" Base="" Strict="true">
      <Counters>
        <Counter Value="TotalCycles"/>
        <Counter Value="InstructionRetired" />
      </Counters>
      <Events>
        <Event Value="CSwitch"/>
      </Events>
    </HardwareCounter>
    
    <Profile Id="Nightjar_Misses_Profile.Verbose.File" Name="Nightjar_Misses_Profile" Description="Profile cache misses and branch mispredictions." Base="" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_Nightjar">
          <SystemProviderId Value="SystemProvider_Nightjar" />
          <HardwareCounterId Value="HardwareCounter_Nightjar_Misses" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  
    <Profile Id="Nightjar_Instructions_Profile.Verbose.File" Name="Nightjar_Instructions_Profile" Description="Profile instructions issued, retired, and cycle count." Base="" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_Nightjar">
          <SystemProviderId Value="SystemProvider_Nightjar" />
          <HardwareCounterId Value="HardwareCounter_Nightjar_Instructions" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  
    <Profile Id="Nightjar_Usage_Profile.Verbose.File" Name="Nightjar_Usage_Profile" Description="Profile context switches, total run time, and cycles per instruction." Base="" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_Nightjar">
          <SystemProviderId Value="SystemProvider_Nightjar" />
          <HardwareCounterId Value="HardwareCounter_Nightjar_Usage" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
