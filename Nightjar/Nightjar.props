<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <LibraryDir>$(SolutionDir)Nightjar\Libraries\</LibraryDir>
    <LibraryOutDir>$(SolutionDir)Build\Libraries\$(Platform)\$(Configuration)\</LibraryOutDir>
    <LibraryOutDirRelease>$(LibraryOutDir)..\Release\</LibraryOutDirRelease>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir />
    <IntDir>$(SolutionDir)Build\Intermediate\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="LibraryDir">
      <Value>$(LibraryDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
    <BuildMacro Include="LibraryOutDir">
      <Value>$(LibraryOutDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
    <BuildMacro Include="LibraryOutDirRelease">
      <Value>$(LibraryOutDirRelease)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
</Project>